<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Ticket Manager</label>
    <description
  >Full access to Ticket__c records, the Ticket Board, and the Tickets app (CLD-1).</description>
    <hasActivationRequired>false</hasActivationRequired>
    <applicationVisibilities>
        <application>Tickets</application>
        <visible>true</visible>
    </applicationVisibilities>
    <classAccesses>
        <apexClass>TicketBoardController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <object>Ticket__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>Ticket__c.Priority__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Ticket__c.Description__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Ticket__c.Assignee__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <tabSettings>
        <tab>Ticket__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Ticket_Board</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
